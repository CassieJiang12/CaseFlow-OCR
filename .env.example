# mock = real OCR + deterministic extraction; no LLM calls or key needed.
# openai = real OCR + OpenAI structured extraction; never silently falls back.
EXTRACTION_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional estimates in USD per ONE MILLION tokens. Verify your model's current
# rates before setting these. Blank means unknown, not free.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
DATABASE_PATH=data/caseflow.sqlite3
MAX_UPLOAD_MB=10
MAX_PAGES=5
MAX_OCR_CHARS=40000
OCR_TIMEOUT_SECONDS=20
LLM_TIMEOUT_SECONDS=30
# Windows example; leave blank if tesseract is on PATH.
TESSERACT_CMD=

